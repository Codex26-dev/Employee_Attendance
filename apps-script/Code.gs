  const legacyCustomers=ss.getSheetByName(COMMERCE_CUSTOMERS_TAB_);
  if(legacyCustomers&&legacyCustomers.getLastRow()>1)commerceRows_(legacyCustomers,ss).forEach(c=>{const rows=clientRows_(sh),nk=clientNameKey_(c['Customer Name']),pk=clientPhoneKey_(c.Phone);if(!rows.some(r=>clientNameKey_(r['Client Name'])===nk||(pk&&clientPhoneKey_(r.Mobile)===pk)))try{clientUpsert_(ss,{id:c['Customer ID'],name:c['Customer Name'],mobile:c.Phone,email:c.Email,gstin:c.GSTIN,billingAddress:c.Address},'Migration')}catch(_){}});
