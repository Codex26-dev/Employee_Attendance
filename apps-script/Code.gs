function appGetMyData(token) {
  const e = employeeForSession_(token), ss = spreadsheet_();
  const today = workdayDateKey_(new Date());
  const attendance = mergeActivityRows_(rowsForEmployee_(ss,APP.ATTENDANCE,e.id,5000),legacyAttendance_(ss,e.id),5000);
  const todayRows = attendance.filter(r => sheetDateKey_(r['Work Date'],APP.WORKDAY_TIME_ZONE) === today);
  const checkIn = todayRows.find(r => r.Event === 'CHECK_IN') || null;
  const checkOut = todayRows.find(r => r.Event === 'CHECK_OUT') || null;
  return {today:today,todayAttendance:{checkIn:checkIn,checkOut:checkOut},attendance:attendance.slice(0,30),progress:mergeActivityRows_(rowsForEmployee_(ss,APP.PROGRESS,e.id,5000),legacyProgress_(ss,e.id),30)};
}

function appPunch(token, event, lat, lon, accuracy) {
  const e = employeeForSession_(token), kind = String(event || '').toUpperCase();
  if (!['CHECK_IN','CHECK_OUT'].includes(kind)) throw new Error('Unknown attendance action.');
  const p = PropertiesService.getScriptProperties();
  const maxAccuracy = Number(p.getProperty('MAX_LOCATION_ACCURACY_METERS') || 100);
  const hasLocation = lat !== '' && lat !== null && lat !== undefined && lon !== '' && lon !== null && lon !== undefined;
  let la='',lo='',acc='',dist='',geofence='NOT PROVIDED';
  if (hasLocation) {
    la=Number(lat); lo=Number(lon); acc=Number(accuracy);
    if (!Number.isFinite(la)||!Number.isFinite(lo)||la < -90||la > 90||lo < -180||lo > 180) throw new Error('Location reading is invalid. Retry without location or try again.');
    const officeLat=Number(p.getProperty('OFFICE_LATITUDE')),officeLon=Number(p.getProperty('OFFICE_LONGITUDE')),radius=Number(p.getProperty('GEOFENCE_RADIUS_METERS'));
    if (Number.isFinite(acc)&&acc>=0) {
      if (Number.isFinite(officeLat)&&Number.isFinite(officeLon)&&Number.isFinite(radius)) {
        dist=Math.round(distanceMeters_(officeLat,officeLon,la,lo));
        geofence=acc<=maxAccuracy?(dist<=radius?'INSIDE':'OUTSIDE'):'UNVERIFIED · LOW ACCURACY';
      } else geofence=acc<=maxAccuracy?'LOCATION RECORDED · FENCE NOT SET':'UNVERIFIED · LOW ACCURACY';
    } else { acc=''; geofence='UNVERIFIED · ACCURACY MISSING'; }
  }
  // Accept check-in at any time; lateness and missed punches are recorded and
  // classified from the server timestamp for the manager instead of blocking staff.
  const ss = spreadsheet_(), sheet = ensureTab_(ss,APP.ATTENDANCE,APP.AH), now = new Date();
  const workDate = workdayDateKey_(now);
  const lock = LockService.getScriptLock(); lock.waitLock(10000);
  let attendanceRecordId='';
  try {
    const existing = recordsForDate_(sheet,e.id,workDate).concat(legacyAttendance_(ss,e.id).filter(r=>sheetDateKey_(r['Work Date'],APP.WORKDAY_TIME_ZONE)===workDate));
    if (kind === 'CHECK_IN' && existing.some(r => r.Event === 'CHECK_IN')) throw new Error('Check-in is already recorded for today.');
    if (kind === 'CHECK_OUT' && (!existing.some(r => r.Event === 'CHECK_IN') || existing.some(r => r.Event === 'CHECK_OUT'))) throw new Error('Check-in is required and check-out can be recorded once.');
    attendanceRecordId=Utilities.getUuid();
    sheet.appendRow([attendanceRecordId,e.id,e.name,e.mobile,kind,now,workDate,la,lo,acc===''?'':Math.round(acc),dist,geofence]);
  } finally { try { SpreadsheetApp.flush(); } finally { lock.releaseLock(); } }
  if(hasLocation)try{saveAttendancePlace_(ss,attendanceRecordId,la,lo)}catch(_){}
  try{notifyManagers_(kind,kind==='CHECK_IN'?'Employee checked in':'Employee checked out',e.name+' recorded '+(kind==='CHECK_IN'?'check-in':'check-out')+(hasLocation?' · GPS '+la+', '+lo+' · '+geofence:' · GPS not provided')+'.',attendanceRecordId,e.email)}catch(err){console.error('Attendance notification failed: '+err.message)}
  return appGetMyData(token);
}

