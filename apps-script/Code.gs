function ensureAmcReminderTrigger_(){if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='sendAmcReminders_'))ScriptApp.newTrigger('sendAmcReminders_').timeBased().everyDays(1).atHour(9).create()}
function sendAmcReminders_(){
  const ss=spreadsheet_(),sh=ss.getSheetByName(AMC_REMINDERS_TAB_);if(!sh||sh.getLastRow()<2)return;
  const tz=ss.getSpreadsheetTimeZone(),today=Utilities.formatDate(new Date(),tz,'yyyy-MM-dd'),v=sh.getDataRange().getValues(),h=v[0].map(String),ix=k=>h.indexOf(k),managers=managerRecipients_();
  v.slice(1).forEach((r,i)=>{
    const row=i+2;if(String(r[ix('Status')])!=='ACTIVE'||r[ix('Last Sent At')])return;
    const remindDate=sheetDate_(r[ix('Reminder Date')],tz),dueDate=sheetDate_(r[ix('Due Date')],tz);if(today<remindDate||today>dueDate)return;
    const name=String(r[ix('Customer Name')]),branch=String(r[ix('Branch Name')]),product=String(r[ix('Product')]),assigned=String(r[ix('Assigned Employee Name')]||'Not assigned'),customerEmail=String(r[ix('Customer Email')]);
    try{
      MailApp.sendEmail(customerEmail,'AMC service reminder — '+branch,'Dear '+name+',\n\nThis is a reminder that the AMC visit for '+product+' at '+branch+' is due on '+dueDate+'. Please contact Rushabh Enterprise to coordinate the visit.\n\nRegards,\n'+(PropertiesService.getScriptProperties().getProperty('AMC_COMPANY_NAME')||'Rushabh Enterprise'));
      sh.getRange(row,ix('Last Sent At')+1).setValue(new Date());sh.getRange(row,ix('Status')+1).setValue('SENT');
      if(managers.length)try{const employeeEmail=employees_().find(e=>e.id===String(r[ix('Assigned Employee ID')]))?.email||'';MailApp.sendEmail(Array.from(new Set(managers.concat(employeeEmail?[employeeEmail]:[]))).join(','),'AMC reminder sent — '+branch,[name+' <'+customerEmail+'>',product+' · due '+dueDate,'Assigned: '+assigned,'Customer reminder sent at '+today].join('\n'))}catch(noticeError){console.error('Internal AMC reminder notice failed: '+noticeError.message)}
    }catch(err){console.error('AMC customer reminder '+r[ix('Reminder ID')]+': '+err.message)}
  });
}
