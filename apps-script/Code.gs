function appManagerSaveAmcReminder(token,payload){const m=employeeForSession_(token);requireManager_(m);const x=payload||{},customer=cleanText_(x.customerName,160),email=normalizeEmail_(x.customerEmail),branch=cleanText_(x.branchName,100),product=cleanText_(x.product,60),due=validDate_(x.dueDate),days=Number(x.daysBefore),employeeId=String(x.employeeId||''),employee=employeeId?employees_().find(e=>e.id===employeeId):null;if(!customer||!/^\S+@\S+\.\S+$/.test(email)||!branch||!AMC_PRODUCTS_.includes(product)||!due||!Number.isInteger(days)||days<0||days>90)throw new Error('Enter a valid customer name and email, branch, product, due date, and reminder lead time.');if(employeeId&&!employee)throw new Error('Choose an active employee for this reminder.');const ss=spreadsheet_(),tz=ss.getSpreadsheetTimeZone(),today=Utilities.formatDate(new Date(),tz,'yyyy-MM-dd');if(due<today)throw new Error('AMC due date must be today or later.');clientUpsert_(ss,{name:customer,email,defaultBranch:branch},m.email||m.name);ensureAmcReminderTrigger_();const dueDate=new Date(due+'T12:00:00'),reminderDate=new Date(dueDate);reminderDate.setDate(reminderDate.getDate()-days);const sheet=ensureTab_(ss,AMC_REMINDERS_TAB_,AMC_REMINDER_HEADERS_);sheet.appendRow([Utilities.getUuid(),customer,email,branch,product,dueDate,reminderDate,days,employee?employee.id:'',employee?employee.name:'','ACTIVE','',new Date(),m.email||m.name]);return {ok:true}}
